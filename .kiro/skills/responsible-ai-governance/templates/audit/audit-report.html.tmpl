<!-- ── INTERACTIVITY ────────────────────────────────────────────────────── -->
<script>
(function() {
  // Read data blob from the embedded JSON block at the bottom of the page.
  const DATA = JSON.parse(document.getElementById('audit-data').textContent);

  // ── Module-level filter state (declared at top — `let` is in TDZ until here,
  //    and the renderXChips() helpers below reference these names) ──
  let rulesActiveStatus = 'all';
  let qActiveVerdict = 'all';

  // ── Tab navigation ──
  const navLinks = document.querySelectorAll('#nav a');
  const pages = document.querySelectorAll('.page');
  navLinks.forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const target = link.dataset.target;
      navLinks.forEach(n => n.classList.toggle('active', n === link));
      pages.forEach(p => p.classList.toggle('active', p.id === 'page-' + target));
      window.scrollTo(0, 0);
    });
  });

  // ── Footer / header meta ──
  document.getElementById('footer-codebase').textContent = DATA.meta.codebase_name || '—';
  document.getElementById('footer-agent').textContent = (DATA.meta.audit_mode || '—') + (DATA.meta.agent_label ? ' (' + DATA.meta.agent_label + ')' : '');
  document.getElementById('footer-time').textContent = formatDate(DATA.meta.generated_at);
  document.getElementById('home-sub').textContent =
    `Audit of "${DATA.meta.codebase_name || 'this project'}" against the AWS Well-Architected Responsible AI Lens.`;

  // ── Configuration page ──
  renderProfile();
  renderPreScreen();
  renderPreScreenContext();

  // ── Overall Results ──
  renderScore();
  renderPillars();
  renderCounts();

  // ── Rules ──
  renderRulesChips();
  renderRules();
  document.getElementById('rule-search').addEventListener('input', renderRules);
  document.getElementById('rule-pillar').addEventListener('change', renderRules);

  // ── Questionnaire ──
  renderQChips();
  renderQuestionnaire();
  document.getElementById('q-search').addEventListener('input', renderQuestionnaire);

  // ── Trend ──
  renderTrend();

  // ─────────────────────────────────────────────────────────────────────────

  function renderProfile() {
    const tbody = document.querySelector('#profile-table tbody');
    const p = DATA.profile || {};
    const rows = [
      ['Project ID', p.project_id || '—'],
      ['Tier', p.tier ? `Tier ${p.tier} — ${p.tier_name || ''}` : '—'],
      ['Codebase Path', p.project_path || '—'],
      ['Documentation Paths', (p.docs_paths || []).join(', ') || '—'],
      ['Activated', formatDate(p.created_at)],
      ['Last Updated', formatDate(p.updated_at)],
    ];
    tbody.innerHTML = rows.map(r => `<tr><th>${r[0]}</th><td>${escapeHtml(r[1])}</td></tr>`).join('');
  }

  function renderPreScreen() {
    const tbody = document.querySelector('#prescreen-table tbody');
    const ps = (DATA.profile && DATA.profile.pre_screen) || {};
    const rows = [
      ['Hosted model (no fine-tuning)', !!ps.hosted_model],
      ['Regulated data (HIPAA / GDPR / financial)', !!ps.regulated_data],
      ['Has formal AI governance process', !!ps.has_governance],
    ];
    tbody.innerHTML = rows.map(r => {
      const cls = r[1] ? 'yes' : 'no';
      const label = r[1] ? 'Yes' : 'No';
      return `<tr><th>${r[0]}</th><td class="${cls}">${label}</td></tr>`;
    }).join('');
  }

  function renderPreScreenContext() {
    const list = document.getElementById('prescreen-context-list');
    const adjustments = (DATA.profile && DATA.profile.applied_adjustments) || [];
    if (adjustments.length === 0) {
      list.innerHTML = `<p class="small">No pre-screen adjustments applied — rules were assessed using their default criteria.</p>`;
      return;
    }
    list.innerHTML = adjustments.map(a =>
      `<div class="pre-screen-context"><strong>${escapeHtml(a.rule_id)}:</strong> ${escapeHtml(a.note)}</div>`
    ).join('');
  }

  function renderScore() {
    const score = (DATA.score && DATA.score.overall_score) || 0;
    const maturity = (DATA.score && DATA.score.maturity_label) || 'Low';
    document.getElementById('score-overall').textContent = score + '%';
    const badge = document.getElementById('maturity-badge');
    badge.textContent = maturity;

    const colors = {
      'Advanced':    { fg: '#16a34a', bg: '#dcfce7', border: '#86efac' },
      'Established': { fg: '#2563eb', bg: '#dbeafe', border: '#93c5fd' },
      'Developing':  { fg: '#d97706', bg: '#fef3c7', border: '#fde68a' },
      'Low':         { fg: '#dc2626', bg: '#fee2e2', border: '#fca5a5' },
    };
    const c = colors[maturity] || colors['Low'];
    document.documentElement.style.setProperty('--maturity-color', c.fg);
    document.documentElement.style.setProperty('--maturity-bg', c.bg);
    document.documentElement.style.setProperty('--maturity-border', c.border);
  }

  function renderPillars() {
    const pillars = (DATA.score && DATA.score.pillar_scores) || {};
    const names = {
      RAIUC: 'Use Case Definition',
      RAIDD: 'Design & Development',
      RAIER: 'Evaluation & Release',
      RAIOP: 'Operations',
    };
    const wrap = document.getElementById('pillar-scores');
    wrap.innerHTML = Object.keys(names).map(p => {
      const v = pillars[p];
      const display = v == null ? '—' : v.toFixed(1) + '%';
      const w = v == null ? 0 : v;
      const grade = maturityFor(v);
      return `<div class="pillar-row">
        <span class="name">${names[p]} <span class="code">${p}</span></span>
        <span class="bar-track"><span class="bar-fill ${grade.key}" style="width:${w}%"></span></span>
        <span class="pct">${display}</span>
        <span class="grade ${grade.key}">${grade.label}</span>
      </div>`;
    }).join('');
  }

  // Map a numeric score (or null) to a {key, label} grade.
  // Thresholds match the maturity_thresholds in the scoring policy.
  function maturityFor(v) {
    if (v == null) return { key: 'unscored', label: 'No data' };
    if (v >= 90)   return { key: 'advanced',    label: 'Advanced' };
    if (v >= 70)   return { key: 'established', label: 'Established' };
    if (v >= 40)   return { key: 'developing',  label: 'Developing' };
    return             { key: 'low',         label: 'Low' };
  }

  function renderCounts() {
    const c = (DATA.score && DATA.score.counts) || {};
    const order = [
      ['compliant',     'Compliant'],
      ['partial',       'Partial'],
      ['non_compliant', 'Non-compliant'],
      ['unknown',       'Unknown'],
      ['needs_input',   'Needs Input'],
      ['disabled',      'Disabled'],
    ];
    document.getElementById('counts-strip').innerHTML = order.map(([k, lbl]) =>
      `<div class="count-cell ${k}"><div class="n">${safeCount(c[k])}</div><div class="lbl">${escapeHtml(lbl)}</div></div>`
    ).join('');
  }

  // ── Rules table with filter chips ──
  function renderRulesChips() {
    const findings = DATA.findings || [];
    const counts = { all: findings.length };
    findings.forEach(f => { counts[f.status] = (counts[f.status] || 0) + 1; });
    const order = ['all', 'compliant', 'partial', 'non_compliant', 'unknown', 'needs_input', 'disabled'];
    const labels = { all: 'All', compliant: 'Compliant', partial: 'Partial', non_compliant: 'Non-compliant',
                     unknown: 'Unknown', needs_input: 'Needs Input', disabled: 'Disabled' };
    document.getElementById('rule-chips').innerHTML = order.map(s => {
      const ct = counts[s] || 0;
      const cls = s === rulesActiveStatus ? 'chip active' : 'chip';
      return `<span class="${cls}" data-status="${s}">${labels[s]}<span class="ct">${ct}</span></span>`;
    }).join('');
    document.querySelectorAll('#rule-chips .chip').forEach(c => {
      c.addEventListener('click', () => { rulesActiveStatus = c.dataset.status; renderRulesChips(); renderRules(); });
    });
  }
  function renderRules() {
    const findings = DATA.findings || [];
    const search = document.getElementById('rule-search').value.toLowerCase();
    const pillarFilter = document.getElementById('rule-pillar').value;
    const wrap = document.getElementById('rules-list');
    const filtered = findings.filter(f => {
      if (rulesActiveStatus !== 'all' && f.status !== rulesActiveStatus) return false;
      if (pillarFilter && f.pillar !== pillarFilter) return false;
      if (search) {
        const blob = (f.rule_id + ' ' + (f.name||'') + ' ' + (f.reasoning||'') + ' ' + (f.evidence||'')).toLowerCase();
        if (blob.indexOf(search) === -1) return false;
      }
      return true;
    });
    if (filtered.length === 0) {
      wrap.innerHTML = `<div class="empty"><div class="icon">🔍</div><h4>No rules match your filters</h4><p>Try clearing the search or status filter.</p></div>`;
      return;
    }
    wrap.innerHTML = filtered.map(f => {
      const pri = f.priority ? `<span class="pill ${escapeHtml(f.priority)}">${escapeHtml(f.priority)}</span>` : '';
      return `<details class="item expandable" data-status="${escapeHtml(f.status)}">
        <summary class="item-head">
          <span class="id">${escapeHtml(f.rule_id)}</span>
          <span class="name">${escapeHtml(f.name || '')}</span>
          <span class="pill ${escapeHtml(f.status)}">${escapeHtml(f.status || 'unknown')}</span>
          ${pri}
        </summary>
        <div class="item-body">
          ${f.pillar ? row('Pillar', f.pillar) : ''}
          ${f.evidence ? row('Evidence', f.evidence) : ''}
          ${f.reasoning ? row('Reasoning', f.reasoning) : ''}
          ${f.lens_bps && f.lens_bps.length ? rawRow('Lens BPs', f.lens_bps.map(bp => lensLink(bp)).join(', ')) : ''}
          ${f.remediation ? row('Remediation', f.remediation) : ''}
        </div>
      </details>`;
    }).join('');
  }

  // ── Questionnaire ──
  function renderQChips() {
    const answers = (DATA.questionnaire && DATA.questionnaire.answers) || {};
    const list = Object.values(answers);
    const counts = { all: list.length };
    list.forEach(a => {
      const k = a.verdict || a.status || 'unknown';
      counts[k] = (counts[k] || 0) + 1;
    });
    const order = ['all', 'compliant', 'partial', 'non_compliant', 'unknown', 'auto_resolved', 'deferred'];
    const labels = { all: 'All', compliant: 'Compliant', partial: 'Partial', non_compliant: 'Non-compliant',
                     unknown: 'Unknown', auto_resolved: 'Auto-resolved', deferred: 'Deferred' };
    document.getElementById('q-chips').innerHTML = order.map(s => {
      const ct = counts[s] || 0;
      const cls = s === qActiveVerdict ? 'chip active' : 'chip';
      return `<span class="${cls}" data-verdict="${s}">${labels[s]}<span class="ct">${ct}</span></span>`;
    }).join('');
    document.querySelectorAll('#q-chips .chip').forEach(c => {
      c.addEventListener('click', () => { qActiveVerdict = c.dataset.verdict; renderQChips(); renderQuestionnaire(); });
    });
  }
  function renderQuestionnaire() {
    const answers = (DATA.questionnaire && DATA.questionnaire.answers) || {};
    const lensBps = DATA.lens_bps || {};
    const search = document.getElementById('q-search').value.toLowerCase();
    const wrap = document.getElementById('q-list');

    // Group by block.
    const blocks = {};
    Object.entries(answers).forEach(([lensCode, ans]) => {
      const block = ans.block || 'Other';
      if (!blocks[block]) blocks[block] = [];
      blocks[block].push({ lensCode, ans, bp: lensBps[lensCode] || {} });
    });

    if (Object.keys(blocks).length === 0) {
      wrap.innerHTML = `<div class="empty"><div class="icon">📝</div><h4>No questionnaire responses recorded yet</h4><p>The questionnaire covers governance decisions that aren't visible in code. Ask the agent to walk through the blocks.</p></div>`;
      return;
    }

    let html = '';
    const blockOrder = Object.keys(blocks).sort();
    blockOrder.forEach((blockName, i) => {
      const items = blocks[blockName].filter(({ ans }) => {
        const verdict = ans.verdict || ans.status || 'unknown';
        if (qActiveVerdict !== 'all' && verdict !== qActiveVerdict) return false;
        if (search) {
          const blob = ((ans.question||'') + ' ' + (ans.response||'') + ' ' + (ans.reasoning||'')).toLowerCase();
          if (blob.indexOf(search) === -1) return false;
        }
        return true;
      });
      if (items.length === 0) return;
      html += `<div class="block">
        <div class="block-header">
          <span class="num">${blockName.match(/\d+/) ? blockName.match(/\d+/)[0] : (i+1)}</span>
          <h3>${escapeHtml(blockName)}</h3>
          <span class="meta">${items.length} item${items.length === 1 ? '' : 's'}</span>
        </div>`;
      html += items.map(({ lensCode, ans, bp }) => {
        const verdict = ans.verdict || ans.status || 'unknown';
        return `<details class="item expandable" data-status="${escapeHtml(verdict)}">
          <summary class="item-head">
            <span class="id">${escapeHtml(lensCode)}</span>
            <span class="name">${escapeHtml(ans.question || bp.name || lensCode)}</span>
            <span class="pill ${escapeHtml(verdict)}">${escapeHtml(verdict)}</span>
          </summary>
          <div class="item-body">
            ${bp.focus_area ? row('Focus Area', bp.focus_area) : ''}
            ${ans.response ? row('Response', ans.response) : ''}
            ${ans.reasoning ? row('Reasoning', ans.reasoning) : ''}
            ${ans.file_path ? rawRow('Source File', '<code>' + escapeHtml(ans.file_path) + '</code>') : ''}
            ${rawRow('Lens BP', lensLink(lensCode))}
          </div>
        </details>`;
      }).join('');
      html += `</div>`;
    });

    wrap.innerHTML = html || `<div class="empty"><div class="icon">🔍</div><h4>No questionnaire items match your filters</h4></div>`;
  }

  // ── Score trend (SVG line chart) ──
  function renderTrend() {
    const snaps = (DATA.history && DATA.history.snapshots) || [];
    const svg = document.getElementById('trend-chart');
    const tbody = document.querySelector('#trend-table tbody');
    if (snaps.length === 0) {
      svg.innerHTML = '';
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:1.5rem;">No snapshots recorded yet.</td></tr>';
      return;
    }

    // Compute layout.
    const W = svg.clientWidth || 800;
    const H = 280;
    const pad = { l: 38, r: 20, t: 20, b: 32 };
    const innerW = W - pad.l - pad.r;
    const innerH = H - pad.t - pad.b;
    const xs = snaps.map((_, i) => pad.l + (snaps.length === 1 ? innerW / 2 : (i / (snaps.length - 1)) * innerW));
    const ys = snaps.map(s => pad.t + innerH - ((s.score?.weighted || 0) / 100) * innerH);

    // Build SVG.
    let s = '';
    // Y-axis grid + labels at 0/25/50/75/100.
    [0, 25, 50, 75, 100].forEach(v => {
      const y = pad.t + innerH - (v / 100) * innerH;
      s += `<line class="grid" x1="${pad.l}" x2="${W - pad.r}" y1="${y}" y2="${y}"/>`;
      s += `<text x="${pad.l - 6}" y="${y + 4}" text-anchor="end">${v}</text>`;
    });
    // Area + line.
    if (snaps.length > 1) {
      const linePath = xs.map((x, i) => (i ? 'L' : 'M') + x + ' ' + ys[i]).join(' ');
      const areaPath = linePath + ` L${xs[xs.length-1]} ${pad.t+innerH} L${xs[0]} ${pad.t+innerH} Z`;
      s += `<path class="area" d="${areaPath}"/>`;
      s += `<path class="line" d="${linePath}"/>`;
    }
    // Dots + x-axis labels.
    snaps.forEach((snap, i) => {
      s += `<circle class="dot" cx="${xs[i]}" cy="${ys[i]}" r="4.5"><title>${escapeHtml(snap.label || snap.snapshot_id)}: ${(snap.score?.weighted || 0).toFixed(1)}%</title></circle>`;
      // Show label every nth snapshot to avoid crowding.
      const step = Math.max(1, Math.floor(snaps.length / 6));
      if (i % step === 0 || i === snaps.length - 1) {
        s += `<text x="${xs[i]}" y="${H - pad.b + 16}" text-anchor="middle">${escapeHtml(snap.snapshot_id || ('#' + (i+1)))}</text>`;
      }
    });
    svg.innerHTML = s;

    // Trend table.
    tbody.innerHTML = snaps.map(snap => {
      const score = (snap.score?.weighted || 0).toFixed(1) + '%';
      const delta = snap.delta;
      let dCell = '<span class="delta-zero">—</span>';
      if (delta != null) {
        if (delta > 0) dCell = `<span class="delta-up">+${delta}</span>`;
        else if (delta < 0) dCell = `<span class="delta-down">${delta}</span>`;
        else dCell = `<span class="delta-zero">0</span>`;
      }
      return `<tr>
        <td>${escapeHtml(snap.snapshot_id || '')}</td>
        <td>${formatDate(snap.timestamp)}</td>
        <td>${escapeHtml(snap.trigger || '')}</td>
        <td><strong>${score}</strong></td>
        <td>${dCell}</td>
        <td>${escapeHtml(snap.label || '')}</td>
      </tr>`;
    }).join('');
  }

  // ── Helpers ──
  // row() escapes its value. Use it for anything that originates outside this
  // template — Bedrock verdicts, questionnaire answers, Lens reference data.
  // rawRow() is the explicit opt-out for the few call sites that build their
  // own trusted markup; every rawRow() caller must escape its own inputs.
  function row(label, value) {
    return rawRow(label, escapeHtml(value));
  }
  function rawRow(label, html) {
    return `<div class="row"><span class="label">${escapeHtml(label)}</span><span class="value">${html}</span></div>`;
  }
  function lensLink(lensCode) {
    // Lens BP codes are [A-Z0-9-] by construction. Strip anything else: slug is
    // a URL path segment, so an allowlist blocks attribute breakout and path
    // manipulation in one step. The String() guard also stops a non-string
    // lensCode from throwing on .toLowerCase().
    const slug = String(lensCode == null ? '' : lensCode).toLowerCase().replace(/[^a-z0-9-]/g, '');
    return `<a href="https://docs.aws.amazon.com/wellarchitected/latest/responsible-ai-lens/${slug}.html" target="_blank" rel="noopener">${escapeHtml(lensCode)}</a>`;
  }
  function formatDate(iso) {
    if (!iso) return '—';
    try {
      const d = new Date(iso);
      return d.toLocaleString(undefined, { year: 'numeric', month: 'short', day: 'numeric',
                                             hour: '2-digit', minute: '2-digit' });
    } catch (e) { return iso; }
  }
  function escapeHtml(str) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  // Counts must render as plain digits — never let a non-numeric score.counts
  // value reach innerHTML. Non-finite or negative values fall back to 0.
  function safeCount(v) {
    const n = Number(v);
    return Number.isFinite(n) && n >= 0 ? Math.trunc(n) : 0;
  }
})();
</script>

</body>
</html>
